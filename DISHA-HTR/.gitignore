# Virtual environment
.venv/
venv/
env/

# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
dist/
build/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Logs and local runtime
logs/
*.log

# Hugging Face / torch caches (keep local; do not commit)
.cache/
hf_cache/
torch_cache/

# IDE / OS
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db

# Keep checkpoint/config directories, ignore large weight files
checkpoints/*
!checkpoints/.gitkeep
!checkpoints/README.md
*.bin
*.safetensors
*.pt
*.pth
*.onnx
*.ckpt

# Sample outputs
outputs/
*.png.tmp

# Evaluation run outputs (keep folder; ignore generated artifacts)
evaluation/results/*
!evaluation/results/.gitkeep

# IAM / training data (do not commit archives or extracted images)
datasets/iam/raw/*
!datasets/iam/raw/.gitkeep
datasets/iam/extracted/*
!datasets/iam/extracted/.gitkeep
datasets/iam/processed/*
!datasets/iam/processed/.gitkeep
datasets/iam/manifests/*.csv
datasets/iam/manifests/*.json
!datasets/iam/manifests/.gitkeep
datasets/iam/hf_teklia/
# Large IAM mirrors / archives (keep docs & tiny placeholders only)
datasets/**/*.zip
datasets/**/*.tar
datasets/**/*.tar.gz
datasets/**/*.tgz
training/vigorous/
# Ignore accidental giant dumps under training, keep hardcase/alphabet_pairs trackable
training/**/raw/
training/**/*.zip

# Demo private results / inspect scratch
demo/results/
demo/_inspect/
demo/_probe/
demo/approved/archive_old/
demo/approved/_verify.json
# Fine-tuned demo weights already covered by *.safetensors; keep meta trackable if desired

# Doctor personalization data (samples, adapters, audits) — keep local only
personalization/doctors/
personalization/**/adapters/
personalization/**/samples/
personalization/**/corrections/
personalization/**/audit/

# Judge demo local storage (uploads, legacy originals, records)
judge_demo_data/
